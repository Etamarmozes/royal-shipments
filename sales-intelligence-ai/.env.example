# Sales Intelligence AI — environment variables
# Copy this file to .env and fill in real values. The .env file is gitignored.

# ----- Database -----
# SQLite for MVP. Switch to PostgreSQL by changing this URL, no code changes needed.
DATABASE_URL=sqlite:///./sales_intelligence.db

# ----- AI -----
# Anthropic Claude API key — used by the AI chat and CEO summary generator.
# Get one at https://console.anthropic.com/
# Without this key the AI chat falls back to a local rule-based responder.
ANTHROPIC_API_KEY=

# Model to use for AI answers
ANTHROPIC_MODEL=claude-sonnet-4-6

# ----- Folders (relative to sales-intelligence-ai/) -----
COMAX_REPORTS_DIR=../data/comax_reports
IMPORTED_DIR=../data/imported
FAILED_DIR=../data/failed
ARCHIVE_DIR=../data/archive
SAMPLE_DIR=../data/sample
REPORTS_DIR=../reports
EXPORTS_DIR=../exports
LOGS_DIR=../logs

# ----- Server -----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Folder watcher -----
# How often (seconds) to scan data/comax_reports/ for new files.
WATCHER_INTERVAL_SECONDS=60
WATCHER_ENABLED=true

# ----- Comax API (Phase 2 placeholder — leave blank for now) -----
COMAX_API_BASE_URL=
COMAX_API_KEY=
COMAX_API_USER=
COMAX_API_PASSWORD=
