# Royal Linen — frontend env example.
# Copy to `.env.local` (Vite picks it up automatically) and edit.
#
# All Vite-side env vars must start with VITE_ to be exposed to the browser.

# Where the frontend should call the API at RUNTIME.
# Leave unset in dev — the Vite proxy maps /api/* to the backend.
# In production, set this to the public backend URL (https):
# VITE_API_BASE=https://api.royal-linen.com

# Backend host the dev proxy points at (defaults to http://localhost:8000).
# Useful when developing against a remote backend.
# VITE_BACKEND_URL=http://localhost:8000
