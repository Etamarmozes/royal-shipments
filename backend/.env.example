# Royal Linen — backend env example.
# Copy to `.env` (or set as real OS env vars in production) and edit.

# ---- Database ----
# Local dev (default): SQLite file at ./data/royal_linen.db
# DATABASE_URL=sqlite:///./data/royal_linen.db
# Production:
# DATABASE_URL=postgresql+psycopg2://royal:STRONG_PASSWORD@db.internal:5432/royal_linen

# ---- Auth (REQUIRED in production) ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET=dev-secret-change-me-before-prod
AUTH_TOKEN_TTL_HOURS=24
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=123456

# ---- Emergency admin (BREAK-GLASS — keep in 1Password / OS keychain) ----
# When BOTH are set, this username+password can ALWAYS log in as admin even
# if the database is empty / locked / corrupt or the bootstrap admin row was
# deleted. The synthetic admin is never written to the DB (id = -1).
# Leave both EMPTY in normal operation. Fill in only for emergencies.
EMERGENCY_ADMIN_USERNAME=
EMERGENCY_ADMIN_PASSWORD=

# ---- Public URLs ----
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ---- CORS ----
# Comma-separated list of allowed frontend origins. Include the LAN IP your
# phone uses if you want to test the PWA from your phone in dev.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.20:5173,https://app.royal-linen.com

# ---- Gmail OAuth ----
# Path to the Google OAuth client_secrets JSON downloaded from console.cloud.google.com
GMAIL_CREDENTIALS_FILE=./credentials.json
# Must EXACTLY match the redirect URI you registered in Google Console.
GMAIL_REDIRECT_URI=http://localhost:8000/gmail/callback
# After the OAuth handshake, redirect the browser back to:
GMAIL_FRONTEND_RETURN_URL=http://localhost:5173/email-updates
GMAIL_SYNC_DAYS=7
GMAIL_SYNC_MAX_MESSAGES=100
GMAIL_PREFER_UNREAD=false

# Set true to disable Gmail entirely (account suspended, OAuth revoked, etc).
# All /gmail/* mutation endpoints return 503 with a clear message; the rest of
# the app works as normal in manual-only mode.
GMAIL_DISABLED=false

# ---- File storage ----
# Where to write uploaded documents and product images. In prod mount a volume
# or use rclone/s3-sync to a bucket.
FILE_STORAGE_PATH=./uploads

# ---- Background jobs ----
EMAIL_SYNC_INTERVAL_MINUTES=60
