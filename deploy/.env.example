# ============================================================================
# Royal Linen Shipments — production environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` in the SAME directory as docker-compose.yml:
#
#     cp deploy/.env.example .env
#     chmod 600 .env                     # read-only for the owner
#     editor .env                        # fill in the values below
#
# NEVER commit .env to git.  It contains your DB password, JWT secret,
# and admin bootstrap password.
# ============================================================================

# ---------- public host names ----------
# These must point at your Hetzner box's public IP via DNS A-records.
FRONTEND_HOST=app.royallinenshipments.com
BACKEND_HOST=api.royallinenshipments.com

# ---------- PostgreSQL ----------
# Use a long random password — `openssl rand -base64 32` is a good source.
POSTGRES_DB=royal_linen
POSTGRES_USER=royal_linen
POSTGRES_PASSWORD=replace-with-a-long-random-password

# ---------- JWT signing key ----------
# Generate with:
#     openssl rand -hex 64
# Rotating this invalidates every existing JWT (forces re-login).
AUTH_SECRET=replace-with-64-char-random-hex
AUTH_TOKEN_TTL_HOURS=24

# ---------- First-time admin bootstrap ----------
# Only used on the very first start when the users table is empty.  The
# user will be required to change the password on first login.
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=changeme-on-first-login

# ---------- Emergency / break-glass admin (optional) ----------
# When BOTH are set, a synthetic admin with id=-1 can always log in even
# if the users table is empty/corrupted.  Leave blank to disable.
EMERGENCY_ADMIN_USERNAME=
EMERGENCY_ADMIN_PASSWORD=

# ---------- Gmail integration ----------
# Disabled by default until you create an OAuth client for the prod
# domain.  Flip to `false` only after you've placed credentials.json on
# the host and updated GMAIL_REDIRECT_URI to match the OAuth config.
GMAIL_DISABLED=true
GMAIL_REDIRECT_URI=https://api.royallinenshipments.com/gmail/callback
GMAIL_SYNC_DAYS=7
GMAIL_SYNC_MAX_MESSAGES=100
GMAIL_PREFER_UNREAD=false

# ---------- Background scheduler ----------
# How often the in-app scheduler runs alerts + QC scan + email-sync stub.
EMAIL_SYNC_INTERVAL_MINUTES=60

# ---------- Uvicorn worker count ----------
# 2 is fine for the Hetzner CX22 (2 vCPU).  For CX32+ try 4.
BACKEND_WORKERS=2
